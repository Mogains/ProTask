# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Hour (0-23, local time) when a new "day" starts and Top 3 resets
NEXT_PUBLIC_RESET_HOUR=4

# Google Calendar OAuth (see README)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Optional: extra hosts allowed to load the dev server (e.g. your phone on LAN), comma-separated
DEV_ORIGINS=""
