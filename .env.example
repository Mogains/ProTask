# Copy to .env (gitignored) and fill in. Placeholder values only; never commit real ones.

# SQLite database file (relative to prisma/schema.prisma). Keep it out of the repo.
DATABASE_URL="file:./dev.db"

# Hour (0-23, local time) when a new "day" starts and Top 3 resets
NEXT_PUBLIC_RESET_HOUR=4

# Google Calendar OAuth, from your own Google Cloud project (see "Secrets and setup" in the README)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Where Google tokens are stored: "keychain" (default on macOS) or "encrypted" (default elsewhere).
TOKEN_STORE=""
# Required only for TOKEN_STORE=encrypted. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Optional: extra hosts allowed to load the dev server (e.g. your phone on LAN), comma-separated
DEV_ORIGINS=""
