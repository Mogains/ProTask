generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A goal / to-do item.
model Task {
  id              String    @id @default(cuid())
  title           String
  notes           String?
  dueAt           DateTime?
  /// false = date-only due date (stored as local midnight)
  hasDueTime      Boolean   @default(false)
  /// "HIGH" | "MED" | "LOW"
  priority        String    @default("MED")
  estimateMinutes Int?
  completed       Boolean   @default(false)
  completedAt     DateTime?
  /// "HAVE_TO" | "NICE_TO". A task in the Top 3 keeps its list so it can return there.
  list            String
  /// Order within the list (lower = higher up)
  position        Float
  /// 1, 2 or 3 when pinned to Top 3. Unique, so a slot can only hold one task.
  topSlot         Int?      @unique
  /// "YYYY-MM-DD" day the task was pinned for; used by the morning reset
  topDate         String?
  /// Legacy single event link, migrated into EventLink rows (lib/eventLinks.ts). No longer written.
  calendarEventId String?
  syncError       String?
  /// Its calendar event was deleted in the calendar. Shown on Today; no event is recreated until rescheduled.
  unscheduled     Boolean   @default(false)
  links           EventLink[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([list, position])
}

/// One calendar event that belongs to a task. A task has at most one link of each kind.
model EventLink {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// "DUE" (event on the due date) | "PINNED" (event on the Top 3 day)
  kind            String
  /// Google Calendar event id
  eventId         String    @unique
  /// Google etag of the last version we wrote or read
  etag            String?
  /// contentHash() of title/start/end as of the last sync, when both sides agreed
  contentHash     String?
  /// Google's "updated" time of the last version we saw
  remoteUpdatedAt DateTime?
  lastSyncedAt    DateTime  @default(now())

  @@unique([taskId, kind])
}

/// Per-list sort mode.
model ListSetting {
  /// "HAVE_TO" | "NICE_TO"
  list     String  @id
  autoSort Boolean @default(true)
}

/// One row per day. Drives the streak and the morning "pick your Top 3" prompt.
model DayLog {
  /// "YYYY-MM-DD"
  date            String  @id
  top3Complete    Boolean @default(false)
  promptDismissed Boolean @default(false)
}

/// Single-row store for the connected Google account. OAuth tokens are NOT kept here:
/// they live in the macOS Keychain (or encrypted in tokenCipher, see lib/tokenStore.ts).
model GoogleAccount {
  id           Int       @id @default(1)
  email        String?
  /// Legacy plain-text columns, emptied by the migration in lib/tokenStore.ts. Never written.
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  /// AES-256-GCM ciphertext of the tokens when TOKEN_STORE=encrypted
  tokenCipher  String?
  /// Google incremental sync token for the "Top 3" calendar
  syncToken    String?
  lastPulledAt DateTime?
  /// Google refused the stored tokens (revoked or expired): the user must connect again
  needsReconnect Boolean @default(false)
  /// id of the dedicated "Top 3" calendar
  calendarId   String?
}

/// Single-row owner login. The password is stored as an argon2id hash (PHC string).
model AuthConfig {
  id           Int       @id @default(1)
  passwordHash String
  /// Consecutive failed logins, drives the lockout backoff
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
}

/// Login sessions. Only a SHA-256 of the cookie value is stored, so a copied database can't be used to log in.
model Session {
  id         String   @id
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
}

/// What two-way sync overwrote or removed, so nothing is lost silently. The newest 200 are kept.
model SyncHistory {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  taskId    String?
  taskTitle String
  /// "conflict" | "deleted-in-calendar" | "pinned-moved"
  reason    String
  /// "calendar" | "protask": whose version was kept
  winner    String?
  /// JSON {title, start, end} of the version that was not kept
  lost      String
}
